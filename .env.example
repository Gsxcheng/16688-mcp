# Required: at least 32 characters. Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=
# Optional: pin the Host header when serving behind a reverse proxy (comma-separated).
MCP_ALLOWED_HOSTS=
# 16688 开放平台 → 接入凭证
OPEN16688_APP_ID=
OPEN16688_SECRET=
# Optional: endpoints that spend the wallet, refund or delete are refused unless listed here ('*' = all five):
# /openApi/purchase/create,/openApi/order/refund,/openApi/complaint/refund,/openApi/goods/delete,/openApi/stockSecret/invalidateAll
# OPEN16688_ALLOW_DANGEROUS=
# Optional: 1 = only list/detail/query/balance style endpoints.
# OPEN16688_READ_ONLY=
