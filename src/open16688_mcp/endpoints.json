 {
  "no": 1,
  "group": "商品",
  "name": "商品列表",
  "path": "/openApi/goods/list",
  "note": "本地 + 已代理货源；可按 source 过滤；内存分页",
  "params": [
   {
    "name": "page_no",
    "required": false,
    "type": "int",
    "desc": "页码，默认 1"
   },
   {
    "name": "page_size",
    "required": false,
    "type": "int",
    "desc": "每页条数，默认 20，1–100"
   },
   {
    "name": "keywords",
    "required": false,
    "type": "string",
    "desc": "匹配商品编号 / 名称"
   },
   {
    "name": "source",
    "required": false,
    "type": "string",
    "desc": "local / supply；空则全部"
   }
  ]
 },
 {
  "no": 2,
  "group": "商品",
  "name": "商品详情",
  "path": "/openApi/goods/detail",
  "note": "按 goods_no：优先本地，其次已代理货源",
  "params": [
   {
    "name": "goods_no",
    "required": true,
    "type": "string",
    "desc": "商品编号"
   }
  ]
 },
 {
  "no": 3,
  "group": "商品",
  "name": "创建商品",
  "path": "/openApi/goods/create",
  "note": "goods_no 空=新建自营商品，有值=更新；铺货商品仅支持改加价/分类/排序；需完成商家认证；卡密库存请用「上传卡密」",
  "params": [
   {
    "name": "goods_no",
    "required": false,
    "type": "string",
    "desc": "空则新建；传入则更新对应商品"
   },
   {
    "name": "name",
    "required": true,
    "type": "string",
    "desc": "标题，最长 255；铺货商品不传"
   },
   {
    "name": "image",
    "required": true,
    "type": "string",
    "desc": "封面图 URL，最长 500；铺货商品不传"
   },
   {
    "name": "description",
    "required": false,
    "type": "string",
    "desc": "商品说明"
   },
   {
    "name": "delivery_method",
    "required": false,
    "type": "int",
    "desc": "1 卡密 / 2 内容 / 3 人工发货，默认 1"
   },
   {
    "name": "delivery_order",
    "required": false,
    "type": "int",
    "desc": "发卡顺序：0 先发旧卡 / 1 先发新卡 / 2 随机；仅卡密"
   },
   {
    "name": "limit_quantity",
    "required": false,
    "type": "int",
    "desc": "卡密起购数量，默认 1"
   },
   {
    "name": "warning_stock_quantity",
    "required": false,
    "type": "int",
    "desc": "库存预警数量；卡密默认 5"
   },
   {
    "name": "instruction",
    "required": false,
    "type": "string",
    "desc": "卡密使用说明"
   },
   {
    "name": "content",
    "required": false,
    "type": "string",
    "desc": "内容发货内容（富文本）；delivery_method=2 时必填"
   },
   {
    "name": "manual_instruction",
    "required": false,
    "type": "string",
    "desc": "人工发货说明（富文本）；delivery_method=3 时必填，买家付款后可见"
   },
   {
    "name": "price",
    "required": true,
    "type": "float",
    "desc": "售价，不能低于 0.02"
   },
   {
    "name": "cost_price",
    "required": false,
    "type": "float",
    "desc": "成本价"
   },
   {
    "name": "agent_status",
    "required": false,
    "type": "int",
    "desc": "0 不代理 / 1 开放代理，默认 0"
   },
   {
    "name": "agent_price",
    "required": false,
    "type": "float",
    "desc": "代理价；agent_status=1 时必填且大于 0"
   },
   {
    "name": "source_category_id",
    "required": false,
    "type": "int",
    "desc": "平台货源分类 ID；agent_status=1 时必填"
   },
   {
    "name": "goods_category_no",
    "required": false,
    "type": "string",
    "desc": "店内分类编号"
   },
   {
    "name": "sort",
    "required": false,
    "type": "int",
    "desc": "排序，默认 0"
   },
   {
    "name": "markup_rate",
    "required": false,
    "type": "float",
    "desc": "铺货商品加价百分比，markup_type=0 时生效，0～999.9"
   },
   {
    "name": "markup_type",
    "required": false,
    "type": "int",
    "desc": "铺货加价方式：0百分比 1固定金额，默认 0"
   },
   {
    "name": "markup_money",
    "required": false,
    "type": "float",
    "desc": "铺货固定加价金额，markup_type=1 时必填且大于 0"
   }
  ]
 },
